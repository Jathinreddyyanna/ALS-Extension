# Backend
# For local Docker Postgres:
DATABASE_URL=postgresql://abs:devpassword@localhost:5432/abs_dev
DIRECT_URL=postgresql://abs:devpassword@localhost:5432/abs_dev
# For Supabase (production):
# DATABASE_URL=postgresql://<user>:<password>@<pooler-host>:<port>/<db>
# DIRECT_URL=postgresql://<user>:<password>@<direct-host>:<port>/<db>
REDIS_URL=redis://:devpassword@localhost:6379
GEMINI_API_KEY=your_gemini_api_key_here
NODE_ENV=development
PORT=3001
ALLOWED_ORIGINS=chrome-extension://YOUR_EXTENSION_ID

# Extension (Vite build-time)
VITE_API_BASE_URL=http://localhost:3001/api/v1
