{
  "manifest_version": 3,
  "name": "AI Browser Shield",
  "version": "2.0.0",
  "description": "Real-time AI-powered browser protection against phishing, malware, scams, unsafe downloads, and deceptive redirects.",
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icon48.png",
      "128": "icon128.png"
    },
    "default_title": "AI Browser Shield"
  },
  "options_ui": {
    "page": "dashboard.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "type": "module",
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "tabs",
    "storage",
    "downloads",
    "webNavigation",
    "webRequest",
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "notifications",
    "activeTab",
    "clipboardWrite"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://localhost:3001/*",
    "https://localhost:3001/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "adblock",
        "enabled": true,
        "path": "rules/adblock.json"
      }
    ]
  },
  "web_accessible_resources": [
    {
      "resources": ["assets/*", "icon48.png", "icon128.png"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
