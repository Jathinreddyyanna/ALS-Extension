{
  "name": "ai-browser-shield-backend",
  "version": "2.0.0",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=20 <24"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:db": "tsx watch src/index.ts",
    "dev:nodb": "set NO_DB=true&& tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^5.22.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "envalid": "^8.0.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.4.2",
    "lru-cache": "^10.4.3",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.2.1",
    "pino": "^9.7.0",
    "prisma": "^5.22.0",
    "supertest": "^7.1.1",
    "uuid": "^11.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.19.15",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^10.0.0",
    "nodemon": "^3.1.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^3.0.8"
  }
}
