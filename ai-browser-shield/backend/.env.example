NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://user:pass@localhost:5432/ai_browser_shield
DIRECT_URL=postgresql://user:pass@localhost:5432/ai_browser_shield
REDIS_URL=redis://localhost:6379
GEMINI_API_KEY=
ALLOWED_ORIGINS=chrome-extension://YOUR_ID,http://localhost:5173,http://localhost:3000
API_KEY=replace_with_long_random_key
ADMIN_KEY=replace_with_long_random_admin_key
DAILY_SALT_SECRET=replace_with_32_char_random_secret
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TIMEOUT_MS=8000
MAX_URL_LENGTH=2048
ENABLE_FILE_SCAN=true
SCAN_CACHE_TTL_LOW=3600
SCAN_CACHE_TTL_HIGH=300
