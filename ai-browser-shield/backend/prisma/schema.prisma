generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model DomainScore {
  id              String           @id @default(uuid())
  domain          String           @unique
  riskScore       Int              @default(0)
  reportCount     Int              @default(0)
  trustScore      Int              @default(50)
  categories      String[]         @default([])
  categoryCounts  Json             @default("{}") @map("category_counts")
  isConfirmed     Boolean          @default(false) @map("is_confirmed")
  isWhitelisted   Boolean          @default(false) @map("is_whitelisted")
  firstSeen       DateTime         @default(now()) @map("first_seen")
  lastReportAt    DateTime?        @map("last_report_at")
  lastUpdated     DateTime         @updatedAt @map("last_updated")
  scanCount       Int              @default(0)
  detectionEvents DetectionEvent[]
  threatReports   ThreatReport[]

  @@index([riskScore])
  @@index([lastReportAt])
  @@index([scanCount])
}

model DetectionEvent {
  id            String       @id @default(uuid())
  eventType     EventType
  domain        String
  url           String
  riskScore     Int
  riskLevel     RiskLevel
  signals       Json         @default("{}")
  aiExplanation String?
  verdict       String?
  ipHash        String?
  userAgent     String?
  sessionId     String?
  createdAt     DateTime     @default(now())
  domainScoreId String?
  fileScanId    String?
  domainScore   DomainScore? @relation(fields: [domainScoreId], references: [id])
  fileScan      FileScan?    @relation(fields: [fileScanId], references: [id])

  @@index([domain])
  @@index([createdAt])
  @@index([riskLevel])
  @@index([eventType])
}

model ThreatReport {
  id          String         @id @default(uuid())
  url         String
  domain      String
  category    ThreatCategory
  description String
  signals     Json           @default("{}")
  ipHash      String
  userAgent   String?
  status      ReportStatus   @default(pending)
  adminNotes  String?
  sessionId   String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  domainScore DomainScore    @relation(fields: [domain], references: [domain], onDelete: SetNull)

  @@index([domain])
  @@index([status])
  @@index([createdAt])
}

model FileScan {
  id                String           @id @default(uuid())
  filename          String
  extension         String
  mimeType          String
  sizeBytes         BigInt
  sourceUrl         String
  sourceDomain      String
  verdict           FileVerdict
  confidence        Float
  aiExplanation     String
  indicators        Json             @default("{}")
  recommendedAction String           @map("recommended_action")
  chromeDownloadId  String?          @map("chrome_download_id")
  createdAt         DateTime         @default(now())
  detectionEvents   DetectionEvent[]
  downloadRecords   DownloadRecord[]

  @@index([sourceDomain])
  @@index([createdAt])
  @@index([verdict])
}

model DownloadRecord {
  id               String         @id @default(uuid())
  chromeDownloadId String         @unique @map("chrome_download_id")
  url              String
  filename         String
  mimeType         String
  sizeBytes        BigInt
  status           DownloadStatus @default(pending)
  riskLevel        RiskLevel      @default(LOW)
  aiVerdict        String?        @map("ai_verdict")
  approvedAt       DateTime?      @map("approved_at")
  fileScanId       String?
  sessionId        String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  fileScan         FileScan?      @relation(fields: [fileScanId], references: [id])

  @@index([status])
  @@index([createdAt])
}

model MaliciousFile {
  id         String          @id @default(uuid())
  sha256     String          @unique
  md5        String?
  filename   String
  mimeType   String
  sizeBytes  BigInt
  verdict    FileVerdict
  confidence Float
  source     MaliciousSource
  createdAt  DateTime        @default(now())

  @@index([filename])
}

model AdminLog {
  id         String   @id @default(uuid())
  action     String
  targetType String
  targetId   String
  adminId    String
  notes      String?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([createdAt])
}

model AppStats {
  id             Int      @id @default(1)
  totalScans     Int      @default(0) @map("total_scans")
  totalThreats   Int      @default(0) @map("total_threats")
  totalReports   Int      @default(0) @map("total_reports")
  totalFileScans Int      @default(0) @map("total_file_scans")
  lastUpdated    DateTime @default(now()) @map("last_updated")
}

model RateLimitLog {
  id           String   @id @default(uuid())
  ipHash       String   @map("ip_hash")
  endpoint     String
  requestCount Int      @default(0) @map("request_count")
  windowStart  DateTime @map("window_start")
  blocked      Boolean  @default(false)

  @@index([ipHash, endpoint, windowStart])
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum EventType {
  url_threat
  redirect_chain
  popup_abuse
  download_intercept
  file_scan
  ad_block
  crypto_mining
  data_exfil
}

enum ThreatCategory {
  phishing
  scam
  malware
  redirect
  popup_abuse
  ad_abuse
  data_exfil
  crypto_mining
  other
  clean
  unknown
}

enum ReportStatus {
  pending
  reviewed
  confirmed
  rejected
}

enum FileVerdict {
  SAFE
  SUSPICIOUS
  MALICIOUS
}

enum DownloadStatus {
  pending
  approved
  cancelled
  completed
  flagged
}

enum MaliciousSource {
  ai
  user_report
  admin
}
